<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AppHotel.MainPage"
             Title="App Hotel - Reserva"
             BackgroundColor="#0F172A">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!-- Título com Destaque -->
            <Label Text="Faça sua Reserva" 
                   FontSize="26" 
                   FontAttributes="Bold" 
                   TextColor="#38BDF8" 
                   HorizontalOptions="Center" 
                   Margin="0,10,0,5" />

            <!-- Seleção do Quarto -->
            <Frame CornerRadius="14" Padding="16" BackgroundColor="#1E293B" HasShadow="True" BorderColor="#334155">
                <VerticalStackLayout Spacing="8">
                    <Label Text="🏨 Acomodação:" FontAttributes="Bold" TextColor="#94A3B8" />
                    <Picker x:Name="pck_quarto" 
                            Title="Selecione sua suíte" 
                            ItemDisplayBinding="{Binding Descricao}" 
                            TextColor="White"
                            TitleColor="#64748B" />
                </VerticalStackLayout>
            </Frame>

            <!-- Período da Estadia -->
            <Frame CornerRadius="14" Padding="16" BackgroundColor="#1E293B" HasShadow="True" BorderColor="#334155">
                <VerticalStackLayout Spacing="12">
                    <Label Text="📅 Período da Estadia" FontAttributes="Bold" TextColor="#94A3B8" />

                    <Grid ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="12">
                        <Label Grid.Row="0" Grid.Column="0" Text="Check-in:" TextColor="#CBD5E1" />
                        <DatePicker Grid.Row="1" Grid.Column="0" 
                                    x:Name="dtpck_checkin" 
                                    Format="dd/MM/yyyy" 
                                    DateSelected="dtpck_checkin_DateSelected"
                                    TextColor="White" />

                        <Label Grid.Row="0" Grid.Column="1" Text="Check-out:" TextColor="#CBD5E1" />
                        <DatePicker Grid.Row="1" Grid.Column="1" 
                                    x:Name="dtpck_checkout" 
                                    Format="dd/MM/yyyy"
                                    TextColor="White" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Quantidade de Hóspedes -->
            <Frame CornerRadius="14" Padding="16" BackgroundColor="#1E293B" HasShadow="True" BorderColor="#334155">
                <VerticalStackLayout Spacing="14">
                    <Label Text="👥 Hóspedes" FontAttributes="Bold" TextColor="#94A3B8" />

                    <!-- Adultos -->
                    <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="Adultos:" VerticalOptions="Center" TextColor="#CBD5E1" />
                        <Label Grid.Column="1" Text="{Binding Source={x:Reference stp_adultos}, Path=Value}" VerticalOptions="Center" FontAttributes="Bold" TextColor="White" />
                        <Stepper Grid.Column="2" x:Name="stp_adultos" Minimum="1" Maximum="10" Increment="1" Value="1" />
                    </Grid>

                    <BoxView HeightRequest="1" Color="#334155" />

                    <!-- Crianças -->
                    <Grid ColumnDefinitions="*, Auto, Auto" ColumnSpacing="10" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="Crianças:" VerticalOptions="Center" TextColor="#CBD5E1" />
                        <Label Grid.Column="1" Text="{Binding Source={x:Reference stp_criancas}, Path=Value}" VerticalOptions="Center" FontAttributes="Bold" TextColor="White" />
                        <Stepper Grid.Column="2" x:Name="stp_criancas" Minimum="0" Maximum="10" Increment="1" Value="0" />
                    </Grid>

                </VerticalStackLayout>
            </Frame>

            <!-- Botões de Ação com Estilo Moderno -->
            <Button Text="Avançar para Resumo" 
                    BackgroundColor="#0284C7" 
                    TextColor="White" 
                    FontAttributes="Bold" 
                    CornerRadius="12" 
                    HeightRequest="50"
                    Clicked="Button_Clicked_Avancar" />

            <Button Text="Sobre o Desenvolvedor" 
                    BackgroundColor="#475569" 
                    TextColor="White" 
                    CornerRadius="12" 
                    HeightRequest="45"
                    Clicked="Button_Clicked_Sobre" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>